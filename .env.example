# Spotify Developer Application credentials
# 1. Create an app in https://developer.spotify.com/dashboard
# 2. Add redirect URI: https://127.0.0.1:5173/ or https://localhost:5173/
# 3. Paste your Client ID below:
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
VITE_SPOTIFY_REDIRECT_URI=https://127.0.0.1:5173/

# Apple Music (Optional Phase 5)
VITE_APPLE_MUSIC_DEVELOPER_TOKEN=
